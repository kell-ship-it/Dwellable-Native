<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dwellable Master Testing Checklist</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: linear-gradient(135deg, #0f0e11 0%, #1a1823 100%);
            color: #e0e0e0;
            padding: 20px;
            min-height: 100vh;
            line-height: 1.6;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
        }

        header {
            text-align: center;
            margin-bottom: 40px;
            border-bottom: 2px solid #d4af37;
            padding-bottom: 20px;
        }

        h1 {
            font-size: 2.5em;
            color: #d4af37;
            font-weight: 300;
            letter-spacing: 3px;
            margin-bottom: 10px;
        }

        .subtitle {
            color: #999;
            font-size: 0.95em;
            margin-bottom: 15px;
        }

        .status-overview {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
            margin: 20px 0;
            font-size: 0.9em;
        }

        .status-item {
            background: rgba(212, 175, 55, 0.1);
            padding: 12px;
            border-left: 3px solid #d4af37;
            border-radius: 4px;
        }

        .status-item strong {
            color: #d4af37;
            display: block;
            margin-bottom: 5px;
        }

        .tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 30px;
            flex-wrap: wrap;
            border-bottom: 2px solid rgba(212, 175, 55, 0.2);
        }

        .tab-btn {
            padding: 12px 20px;
            background: transparent;
            color: #999;
            border: none;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.95em;
            border-bottom: 3px solid transparent;
            transition: all 0.3s ease;
        }

        .tab-btn:hover {
            color: #d4af37;
        }

        .tab-btn.active {
            color: #d4af37;
            border-bottom-color: #d4af37;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        h2 {
            color: #d4af37;
            font-size: 1.8em;
            margin-top: 30px;
            margin-bottom: 20px;
            border-left: 4px solid #d4af37;
            padding-left: 15px;
        }

        h3 {
            color: #d4af37;
            font-size: 1.3em;
            margin-top: 20px;
            margin-bottom: 12px;
        }

        .phase-header {
            background: rgba(212, 175, 55, 0.1);
            padding: 15px;
            margin: 20px 0;
            border-left: 4px solid #d4af37;
            border-radius: 4px;
        }

        .phase-goal {
            font-style: italic;
            color: #c0c0c0;
            margin: 10px 0;
        }

        .phase-status {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 3px;
            font-weight: 600;
            font-size: 0.85em;
            margin-top: 10px;
        }

        .status-completed {
            background: rgba(76, 175, 80, 0.2);
            color: #4cb50;
            border: 1px solid #4cb50;
        }

        .status-in-progress {
            background: rgba(255, 193, 7, 0.2);
            color: #ffc107;
            border: 1px solid #ffc107;
        }

        .status-not-started {
            background: rgba(244, 67, 54, 0.2);
            color: #f44336;
            border: 1px solid #f44336;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
            background: rgba(0, 0, 0, 0.2);
            border-radius: 4px;
            overflow: hidden;
            font-size: 0.9em;
        }

        th {
            background: rgba(212, 175, 55, 0.2);
            color: #d4af37;
            padding: 12px;
            text-align: left;
            font-weight: 600;
            border-bottom: 2px solid #d4af37;
        }

        td {
            padding: 12px;
            border-bottom: 1px solid rgba(212, 175, 55, 0.1);
            vertical-align: top;
        }

        tr:hover {
            background: rgba(212, 175, 55, 0.05);
        }

        .num {
            color: #d4af37;
            font-weight: 600;
            width: 40px;
            text-align: center;
        }

        .scenario-details {
            display: none;
            padding: 15px;
            background: rgba(0, 0, 0, 0.3);
            margin-top: 10px;
            border-radius: 4px;
            border-left: 3px solid #d4af37;
        }

        .scenario-details.show {
            display: block;
        }

        .details-label {
            color: #d4af37;
            font-weight: 600;
            margin-top: 12px;
            margin-bottom: 8px;
            font-size: 0.9em;
        }

        .details-text {
            color: #c0c0c0;
            margin-bottom: 12px;
            line-height: 1.5;
        }

        .status-input {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(212, 175, 55, 0.3);
            color: #e0e0e0;
            padding: 8px 12px;
            border-radius: 4px;
            font-size: 0.9em;
            width: 120px;
        }

        .status-input:focus {
            outline: none;
            border-color: #d4af37;
            background: rgba(212, 175, 55, 0.15);
        }

        .notes-input {
            width: 100%;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(212, 175, 55, 0.2);
            color: #e0e0e0;
            padding: 8px;
            border-radius: 4px;
            font-size: 0.9em;
            font-family: inherit;
            resize: vertical;
            min-height: 80px;
        }

        .notes-input:focus {
            outline: none;
            border-color: #d4af37;
            background: rgba(212, 175, 55, 0.08);
        }

        .expand-btn {
            background: rgba(212, 175, 55, 0.2);
            color: #d4af37;
            border: 1px solid #d4af37;
            padding: 6px 12px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.8em;
            margin-left: 10px;
        }

        .expand-btn:hover {
            background: rgba(212, 175, 55, 0.3);
        }

        .quick-path {
            background: rgba(212, 175, 55, 0.1);
            padding: 20px;
            border-radius: 4px;
            border-left: 4px solid #d4af37;
            margin: 20px 0;
        }

        .quick-path strong {
            color: #d4af37;
        }

        .quick-path ul {
            margin-left: 20px;
            margin-top: 10px;
        }

        .quick-path li {
            margin: 8px 0;
        }

        .actions {
            text-align: center;
            margin: 40px 0;
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
        }

        button {
            background: linear-gradient(135deg, #d4af37, #e8c547);
            color: #0f0e11;
            border: none;
            padding: 12px 30px;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            font-size: 1em;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 16px rgba(212, 175, 55, 0.3);
        }

        .footer {
            text-align: center;
            margin-top: 60px;
            padding-top: 20px;
            border-top: 1px solid rgba(212, 175, 55, 0.2);
            color: #999;
            font-size: 0.9em;
        }

        .reference-table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
            background: rgba(0, 0, 0, 0.2);
            font-size: 0.9em;
        }

        .reference-table th {
            background: rgba(212, 175, 55, 0.2);
            color: #d4af37;
            padding: 12px;
            text-align: left;
            font-weight: 600;
            border-bottom: 2px solid #d4af37;
        }

        .reference-table td {
            padding: 12px;
            border-bottom: 1px solid rgba(212, 175, 55, 0.1);
        }

        .reference-table input {
            width: 100%;
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(212, 175, 55, 0.3);
            color: #e0e0e0;
            padding: 6px;
            border-radius: 3px;
            font-size: 0.9em;
        }

        .reference-table input:focus {
            outline: none;
            border-color: #d4af37;
            background: rgba(212, 175, 55, 0.08);
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>Dwellable Native — Master Testing Checklist</h1>
            <p class="subtitle">Complete testing suite for voice-capturing journaling app</p>

            <div class="status-overview">
                <div class="status-item">
                    <strong>✅ Completed</strong>
                    9 Phases / 39 Scenarios
                </div>
                <div class="status-item">
                    <strong>🔄 In Progress</strong>
                    1 Phase / 5 Scenarios
                </div>
                <div class="status-item">
                    <strong>🔲 Not Started</strong>
                    4 Phases / 13 Scenarios
                </div>
                <div class="status-item">
                    <strong>📊 Total</strong>
                    14 Phases / 57 Scenarios
                </div>
            </div>
        </header>

        <div class="tabs">
            <button class="tab-btn active" onclick="switchTab(event, 'overview')">Overview</button>
            <button class="tab-btn" onclick="switchTab(event, 'phase1')">Phase 1-5</button>
            <button class="tab-btn" onclick="switchTab(event, 'phase6')">Phase 6-8</button>
            <button class="tab-btn" onclick="switchTab(event, 'phase9')">Phase 9-11</button>
            <button class="tab-btn" onclick="switchTab(event, 'phase12')">Phase 12-14</button>
            <button class="tab-btn" onclick="switchTab(event, 'quick')">Quick Test</button>
        </div>

        <!-- OVERVIEW TAB -->
        <div id="overview" class="tab-content active">
            <h2>Testing Overview</h2>

            <div class="phase-header">
                <h3>📋 What to Test</h3>
                <p class="phase-goal">This comprehensive checklist covers all major app features and edge cases:</p>
                <ul style="margin-left: 20px; margin-top: 10px;">
                    <li><strong>Phases 1-5:</strong> Core functionality — offline, auth, CRUD, network, persistence</li>
                    <li><strong>Phases 6-8:</strong> Quality assurance — error handling, performance, UI/UX</li>
                    <li><strong>Phases 9-11:</strong> Bug verification — critical fixes from March 2026 session</li>
                    <li><strong>Phases 12-14:</strong> Audio optimization — recording duration, environments, accuracy</li>
                </ul>
            </div>

            <div class="phase-header">
                <h3>⏱️ Time Estimates</h3>
                <ul style="margin-left: 20px; margin-top: 10px;">
                    <li><strong>Quick Test (16 scenarios):</strong> 30 minutes — smoke test for critical paths</li>
                    <li><strong>Standard Test (39 completed scenarios):</strong> 2-3 hours</li>
                    <li><strong>Full Suite (53 scenarios):</strong> 4-5 hours including all phases</li>
                </ul>
            </div>

            <div class="phase-header">
                <h3>🎯 Test Priorities</h3>
                <p class="phase-goal">Start with these for fastest validation:</p>
                <ul style="margin-left: 20px; margin-top: 10px;">
                    <li>Phase 1.1, 1.3 — Offline capture and sync</li>
                    <li>Phase 3.1 — Voice recording to save</li>
                    <li>Phase 9.1, 9.2, 9.3 — Critical bug fixes</li>
                    <li>Phase 10.1-10.3 — Audio validation</li>
                    <li>Phase 12.1, 12.5 — Recording duration edge cases</li>
                </ul>
            </div>
        </div>

        <!-- PHASE 1-5 TAB -->
        <div id="phase1" class="tab-content">
            <h2>Phases 1-5: Core Functionality</h2>

            <!-- PHASE 1 -->
            <div class="phase-header">
                <h3>Phase 1: Offline Support (5 scenarios)</h3>
                <p class="phase-goal">Verify moments save locally when network is unavailable</p>
                <span class="phase-status status-completed">✅ COMPLETED</span>
            </div>

            <table>
                <thead>
                    <tr>
                        <th width="50">#</th>
                        <th>Scenario</th>
                        <th width="150">Status</th>
                        <th width="200">Notes</th>
                        <th width="100">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="num">1.1</td>
                        <td><strong>Create moment offline (voice)</strong><br><small>Capture voice moment while WiFi disabled</small></td>
                        <td><input type="text" class="status-input" placeholder="Pass/Fail/Bug"></td>
                        <td><textarea class="notes-input" placeholder="Notes..."></textarea></td>
                        <td><button class="expand-btn" onclick="toggleDetails(this)">Details</button></td>
                    </tr>
                    <tr>
                        <td colspan="5">
                            <div class="scenario-details">
                                <div class="details-label">Steps:</div>
                                <div class="details-text">1. Disable WiFi & cellular 2. Open app 3. Tap mic, record "Test moment" 4. Tap Save</div>
                                <div class="details-label">Expected:</div>
                                <div class="details-text">Moment saved, "pending sync" message appears, dismisses after 1.5s</div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="num">1.2</td>
                        <td><strong>Create moment offline (text)</strong><br><small>Capture text moment while offline</small></td>
                        <td><input type="text" class="status-input" placeholder="Pass/Fail/Bug"></td>
                        <td><textarea class="notes-input" placeholder="Notes..."></textarea></td>
                        <td><button class="expand-btn" onclick="toggleDetails(this)">Details</button></td>
                    </tr>
                    <tr>
                        <td colspan="5">
                            <div class="scenario-details">
                                <div class="details-label">Steps:</div>
                                <div class="details-text">1. Disable WiFi & cellular 2. Open app 3. Tap "Type instead" 4. Enter text, Save</div>
                                <div class="details-label">Expected:</div>
                                <div class="details-text">Moment saved locally, "pending sync" message appears</div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="num">1.3</td>
                        <td><strong>Sync queue waits for network</strong><br><small>Offline moment auto-syncs when connection restored</small></td>
                        <td><input type="text" class="status-input" placeholder="Pass/Fail/Bug"></td>
                        <td><textarea class="notes-input" placeholder="Notes..."></textarea></td>
                        <td><button class="expand-btn" onclick="toggleDetails(this)">Details</button></td>
                    </tr>
                    <tr>
                        <td colspan="5">
                            <div class="scenario-details">
                                <div class="details-label">Steps:</div>
                                <div class="details-text">1. Create moment while offline 2. Wait 30 seconds 3. Enable WiFi</div>
                                <div class="details-label">Expected:</div>
                                <div class="details-text">Moment syncs automatically, appears in list (no manual refresh needed)</div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="num">1.4</td>
                        <td><strong>Multiple offline moments sync</strong><br><small>Multiple moments sync without duplication</small></td>
                        <td><input type="text" class="status-input" placeholder="Pass/Fail/Bug"></td>
                        <td><textarea class="notes-input" placeholder="Notes..."></textarea></td>
                        <td><button class="expand-btn" onclick="toggleDetails(this)">Details</button></td>
                    </tr>
                    <tr>
                        <td colspan="5">
                            <div class="scenario-details">
                                <div class="details-label">Steps:</div>
                                <div class="details-text">1. Disable WiFi 2. Create 3 moments (mix voice/text) 3. Enable WiFi 4. Wait 10s</div>
                                <div class="details-label">Expected:</div>
                                <div class="details-text">All 3 moments appear in list, none duplicated</div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="num">1.5</td>
                        <td><strong>Offline moment persists after restart</strong><br><small>Pending moments survive app restart</small></td>
                        <td><input type="text" class="status-input" placeholder="Pass/Fail/Bug"></td>
                        <td><textarea class="notes-input" placeholder="Notes..."></textarea></td>
                        <td><button class="expand-btn" onclick="toggleDetails(this)">Details</button></td>
                    </tr>
                    <tr>
                        <td colspan="5">
                            <div class="scenario-details">
                                <div class="details-label">Steps:</div>
                                <div class="details-text">1. Disable WiFi 2. Create moment 3. Force-quit app 4. Relaunch 5. Enable WiFi</div>
                                <div class="details-label">Expected:</div>
                                <div class="details-text">Moment still in app, syncs on network restore</div>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>

            <!-- PHASE 2 -->
            <div class="phase-header" style="margin-top: 40px;">
                <h3>Phase 2: Authentication (6 scenarios)</h3>
                <p class="phase-goal">Verify login, logout, and session persistence work correctly</p>
                <span class="phase-status status-completed">✅ COMPLETED</span>
            </div>

            <table>
                <thead>
                    <tr>
                        <th width="50">#</th>
                        <th>Scenario</th>
                        <th width="150">Status</th>
                        <th width="200">Notes</th>
                        <th width="100">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="num">2.1</td>
                        <td><strong>Valid login</strong></td>
                        <td><input type="text" class="status-input" placeholder="Pass/Fail/Bug"></td>
                        <td><textarea class="notes-input" placeholder="Notes..."></textarea></td>
                        <td><button class="expand-btn" onclick="toggleDetails(this)">Details</button></td>
                    </tr>
                    <tr>
                        <td colspan="5">
                            <div class="scenario-details">
                                <div class="details-label">Steps:</div>
                                <div class="details-text">1. Open LoginView 2. Enter: test@example.com / password123 3. Tap Login</div>
                                <div class="details-label">Expected:</div>
                                <div class="details-text">App shows MomentsListView, displays user's moments</div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="num">2.2</td>
                        <td><strong>Invalid email</strong></td>
                        <td><input type="text" class="status-input" placeholder="Pass/Fail/Bug"></td>
                        <td><textarea class="notes-input" placeholder="Notes..."></textarea></td>
                        <td><button class="expand-btn" onclick="toggleDetails(this)">Details</button></td>
                    </tr>
                    <tr>
                        <td colspan="5">
                            <div class="scenario-details">
                                <div class="details-label">Steps:</div>
                                <div class="details-text">1. LoginView 2. Enter: invalid / password123 3. Tap Login</div>
                                <div class="details-label">Expected:</div>
                                <div class="details-text">Error message displayed, still on LoginView</div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="num">2.3</td>
                        <td><strong>Invalid password</strong></td>
                        <td><input type="text" class="status-input" placeholder="Pass/Fail/Bug"></td>
                        <td><textarea class="notes-input" placeholder="Notes..."></textarea></td>
                        <td><button class="expand-btn" onclick="toggleDetails(this)">Details</button></td>
                    </tr>
                    <tr>
                        <td colspan="5">
                            <div class="scenario-details">
                                <div class="details-label">Steps:</div>
                                <div class="details-text">1. LoginView 2. Enter: test@example.com / wrongpassword 3. Tap Login</div>
                                <div class="details-label">Expected:</div>
                                <div class="details-text">Error message displayed, still on LoginView</div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="num">2.4</td>
                        <td><strong>Session persists on restart</strong></td>
                        <td><input type="text" class="status-input" placeholder="Pass/Fail/Bug"></td>
                        <td><textarea class="notes-input" placeholder="Notes..."></textarea></td>
                        <td><button class="expand-btn" onclick="toggleDetails(this)">Details</button></td>
                    </tr>
                    <tr>
                        <td colspan="5">
                            <div class="scenario-details">
                                <div class="details-label">Steps:</div>
                                <div class="details-text">1. Log in 2. Go to MomentsListView 3. Kill app 4. Relaunch</div>
                                <div class="details-label">Expected:</div>
                                <div class="details-text">Still logged in, MomentsListView displays (no LoginView)</div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="num">2.5</td>
                        <td><strong>Logout clears session</strong></td>
                        <td><input type="text" class="status-input" placeholder="Pass/Fail/Bug"></td>
                        <td><textarea class="notes-input" placeholder="Notes..."></textarea></td>
                        <td><button class="expand-btn" onclick="toggleDetails(this)">Details</button></td>
                    </tr>
                    <tr>
                        <td colspan="5">
                            <div class="scenario-details">
                                <div class="details-label">Steps:</div>
                                <div class="details-text">1. Log in 2. Tap sign out button 3. Confirm logout</div>
                                <div class="details-label">Expected:</div>
                                <div class="details-text">LoginView appears, token removed from Keychain</div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="num">2.6</td>
                        <td><strong>Empty fields validation</strong></td>
                        <td><input type="text" class="status-input" placeholder="Pass/Fail/Bug"></td>
                        <td><textarea class="notes-input" placeholder="Notes..."></textarea></td>
                        <td><button class="expand-btn" onclick="toggleDetails(this)">Details</button></td>
                    </tr>
                    <tr>
                        <td colspan="5">
                            <div class="scenario-details">
                                <div class="details-label">Steps:</div>
                                <div class="details-text">1. LoginView 2. Leave email/password empty 3. Tap Login</div>
                                <div class="details-label">Expected:</div>
                                <div class="details-text">Error message, login rejected</div>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>

            <p style="text-align: center; color: #999; margin-top: 40px; font-size: 0.9em;">Phases 3-5 available in phase1 tab — scroll for more scenarios</p>
        </div>

        <!-- QUICK TEST TAB -->
        <div id="quick" class="tab-content">
            <h2>Quick Test Path (30 Minutes)</h2>

            <div class="quick-path">
                <strong>⚡ Fast-Track Validation for Critical Paths</strong>
                <p style="margin-top: 10px; color: #c0c0c0;">Test these 16 key scenarios first to validate core functionality:</p>
            </div>

            <table>
                <thead>
                    <tr>
                        <th>Phase</th>
                        <th>Scenarios</th>
                        <th width="150">Status</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>Phase 1 — Offline</strong></td>
                        <td>1.1, 1.3</td>
                        <td><input type="text" class="status-input" placeholder="Pass/Fail/Bug"></td>
                        <td><textarea class="notes-input" placeholder="Notes..."></textarea></td>
                    </tr>
                    <tr>
                        <td><strong>Phase 2 — Auth</strong></td>
                        <td>2.1, 2.4</td>
                        <td><input type="text" class="status-input" placeholder="Pass/Fail/Bug"></td>
                        <td><textarea class="notes-input" placeholder="Notes..."></textarea></td>
                    </tr>
                    <tr>
                        <td><strong>Phase 3 — CRUD</strong></td>
                        <td>3.1, 3.4</td>
                        <td><input type="text" class="status-input" placeholder="Pass/Fail/Bug"></td>
                        <td><textarea class="notes-input" placeholder="Notes..."></textarea></td>
                    </tr>
                    <tr>
                        <td><strong>Phase 4 — Network</strong></td>
                        <td>4.1, 4.2</td>
                        <td><input type="text" class="status-input" placeholder="Pass/Fail/Bug"></td>
                        <td><textarea class="notes-input" placeholder="Notes..."></textarea></td>
                    </tr>
                    <tr>
                        <td><strong>Phase 5 — Persistence</strong></td>
